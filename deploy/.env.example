# Installed as /etc/chainfolio.env, read by systemd.
# Use matching local and remote ports in the SSH tunnel.
PORT=3089
DATA_DIR=/var/lib/chainfolio
# Optional initial settings; settings saved in the web UI take precedence.
ETH_RPC_URL=
BSC_RPC_URL=
# Leave empty for SSH tunnel access; e.g. https://YOUR_PUBLIC_IP for 1Panel.
# Requires HTTPS and site-wide password access at the reverse proxy.
PUBLIC_ORIGIN=
